{
  "identifier": "default",
  "description": "Default capabilities for mynig.ga desktop app",
  "windows": ["main"],
  "remote": {
    "urls": ["https://mynig.ga/*"]
  },
  "permissions": [
    "core:default",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify"
  ]
}
